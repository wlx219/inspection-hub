# API 服务配置
VITE_API_URL=http://localhost:3001/api

# OCR 服务选择
# 可选值: tesseract (本地), aliyun, tencent
VITE_OCR_PROVIDER=tesseract

# 阿里云 OCR 配置 (高精度表格识别)
# VITE_ALIYUN_ACCESS_KEY_ID=your_access_key_id
# VITE_ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# VITE_ALIYUN_REGION=cn-shanghai

# 腾讯云 OCR 配置 (高精度表格识别)
# VITE_TENCENT_SECRET_ID=your_secret_id
# VITE_TENCENT_SECRET_KEY=your_secret_key

# 文件存储 (可选)
# VITE_STORAGE_PROVIDER=aliyun
# VITE_ALI_OSS_BUCKET=your_bucket_name
# VITE_ALI_OSS_REGION=cn-shanghai
